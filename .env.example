# Salin menjadi .env untuk pengembangan lokal.
# Kosongkan dua baris Turso agar memakai file lokal data/jurnal.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Wajib di produksi (minimal 16 karakter). Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Zona waktu untuk tampilan tanggal
APP_TZ=Asia/Jakarta
PORT=3000
